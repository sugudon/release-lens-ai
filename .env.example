# Application
APP_NAME=ReleaseLens AI
APP_ENV=development
DEBUG=true

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# LangSmith
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=release-lens-ai

# PostgreSQL
DATABASE_URL=postgresql+psycopg://release_lens:release_lens_password@localhost:5432/release_lens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=release_lens
POSTGRES_USER=release_lens
POSTGRES_PASSWORD=release_lens_password